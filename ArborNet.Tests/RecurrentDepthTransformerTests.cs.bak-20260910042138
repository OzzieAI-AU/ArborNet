namespace ArborNet.Models
{
    using System;
    using System.Collections.Generic;
    using System.IO;
    using System.Text.Json;
    using ArborNet.Core.Devices;
    using ArborNet.Core.Interfaces;
    using ArborNet.Core.Models;
    using ArborNet.Core.Tensors;
    using ArborNet.Layers;

    public class RecurrentDepthTransformer : BaseModel, IRecurrentLayer
    {
        private readonly int _vocabSize;
        private readonly int _hiddenDim;
        private readonly int _ffnDim;
        private readonly int _numHeads;
        private readonly int _maxSequenceLength;
        private readonly int _factorDim;
        private int _defaultLoops;
        private readonly int _maxLoops;
        private int _activeLoops;

        private ITensor _tokenEmbedding;
        private ITensor _embeddingProjection;
        private readonly LoopedTransformerCore _core;

        public int DefaultLoops
        {
            get => _defaultLoops;
            set
            {
                if (value < 1 || value > _maxLoops)
                {
                    throw new ArgumentOutOfRangeException(nameof(value), $"Default loops must be in [1, {_maxLoops}].");
                }
                _defaultLoops = value;
            }
        }

        public int MaxLoops => _maxLoops;
        public int RecurrentSteps => _activeLoops;
        public int HiddenDim => _hiddenDim;
        public int FfnDim => _ffnDim;
        public int NumHeads => _numHeads;
        public int VocabSize => _vocabSize;
        public int MaxSequenceLength => _maxSequenceLength;

        /// <summary>
        /// Gets or sets the current runtime recurrence depth used during forward passes.
        /// </summary>
        public int ActiveLoops
        {
            get => _activeLoops;
            set
            {
                if (value < 1 || value > _maxLoops)
                {
                    throw new ArgumentOutOfRangeException(nameof(value), $"Active loops must be between 1 and MaxLoops ({_maxLoops}).");
                }
                _activeLoops = value;
            }
        }

        public RecurrentDepthTransformer(
            int vocabSize = 32,
            int hiddenDim = 64,
            int ffnDim = 128,
            int numHeads = 4,
            int maxSequenceLength = 512,
            int defaultLoops = 8,
            int maxLoops = 16,
            int factorDim = 8,
            Device? device = null)
        {
            if (vocabSize <= 0) throw new ArgumentOutOfRangeException(nameof(vocabSize));
            if (hiddenDim <= 0) throw new ArgumentOutOfRangeException(nameof(hiddenDim));
            if (ffnDim <= 0) throw new ArgumentOutOfRangeException(nameof(ffnDim));
            if (numHeads <= 0) throw new ArgumentOutOfRangeException(nameof(numHeads));
            if (maxLoops < 1) throw new ArgumentOutOfRangeException(nameof(maxLoops));
            if (defaultLoops < 1 || defaultLoops > maxLoops)
            {
                throw new ArgumentOutOfRangeException(nameof(defaultLoops), $"defaultLoops must be between 1 and maxLoops ({maxLoops}).");
            }
            if (factorDim <= 0) throw new ArgumentOutOfRangeException(nameof(factorDim));

            device ??= Device.CPU;
            this.device = device;

            _vocabSize = vocabSize;
            _hiddenDim = hiddenDim;
            _ffnDim = ffnDim;
            _numHeads = numHeads;
            _maxSequenceLength = maxSequenceLength;
            _defaultLoops = defaultLoops;
            _activeLoops = defaultLoops;
            _maxLoops = maxLoops;
            _factorDim = factorDim;

            // Factorized token embedding: [V x factorDim] + [factorDim x hiddenDim]
            _tokenEmbedding = Tensor.Randn(new TensorShape(vocabSize, factorDim), device).Multiply(0.02f);
            _tokenEmbedding.RequiresGrad = true;

            _embeddingProjection = Tensor.Randn(new TensorShape(factorDim, hiddenDim), device).Multiply(0.02f);
            _embeddingProjection.RequiresGrad = true;

            // Shared recurrent transformer core
            _core = new LoopedTransformerCore(hiddenDim, ffnDim, numHeads);

            RebuildParameters();
        }

        private void RebuildParameters()
        {
            parameters.Clear();
            var seen = new HashSet<ITensor>(ReferenceEqualityComparer.Instance);

            void AddUnique(ITensor? t)
            {
                if (t != null && seen.Add(t))
                {
                    parameters.Add(t);
                }
            }

            AddUnique(_tokenEmbedding);
            AddUnique(_embeddingProjection);

            if (_core != null)
            {
                foreach (var p in _core.Parameters())
                {
                    AddUnique(p);
                }
            }
        }

        public override ITensor Forward(ITensor inputTokens) => Forward(inputTokens, null);

        public ITensor Forward(ITensor inputTokens, int? loops = null)
        {
            ArgumentNullException.ThrowIfNull(inputTokens);

            int effectiveLoops = loops ?? _activeLoops;
            if (effectiveLoops < 1 || effectiveLoops > _maxLoops)
            {
                throw new ArgumentOutOfRangeException(nameof(loops), $"Loops ({effectiveLoops}) must be between 1 and MaxLoops ({_maxLoops}).");
            }

            // Sync property if explicitly overridden for this pass
            if (loops.HasValue)
            {
                _activeLoops = effectiveLoops;
            }

            int batch = inputTokens.Shape.Rank >= 2 ? inputTokens.Shape[0] : 1;
            int seqLen = inputTokens.Shape.Rank >= 2 ? inputTokens.Shape[1] : inputTokens.Shape[0];

            // 1. Prelude: Factorized token embedding lookup
            ITensor factorRep = EmbeddingLookup(_tokenEmbedding, inputTokens); // [batch * seqLen, factorDim]
            ITensor flatHidden = factorRep.MatMul(_embeddingProjection);       // [batch * seqLen, hiddenDim]
            ITensor contextual = flatHidden.Reshape(batch, seqLen, _hiddenDim);

            // 2. Shared Core Recurrent Depth Loop
            for (int step = 0; step < effectiveLoops; step++)
            {
                contextual = _core.Forward(contextual);
            }

            // 3. Coda: Tied unembedding projection
            ITensor flatContextual = contextual.Reshape(batch * seqLen, _hiddenDim);
            ITensor projectedBack = flatContextual.MatMul(_embeddingProjection.Transpose(new[] { 1, 0 }));
            ITensor flatLogits = projectedBack.MatMul(_tokenEmbedding.Transpose(new[] { 1, 0 }));

            return flatLogits.Reshape(batch, seqLen, _vocabSize);
        }

        private static ITensor EmbeddingLookup(ITensor embeddingTable, ITensor indices)
        {
            if (indices.Shape.Rank == 2 && indices.Shape[1] == embeddingTable.Shape[0])
            {
                return indices.MatMul(embeddingTable);
            }

            int numTokens = indices.Shape.TotalElements;
            int vocabSize = embeddingTable.Shape[0];
            float[] tokenData = indices.ToArray();
            float[] oneHotData = new float[numTokens * vocabSize];

            for (int i = 0; i < numTokens; i++)
            {
                int id = (int)tokenData[i];
                if (id >= 0 && id < vocabSize)
                {
                    oneHotData[i * vocabSize + id] = 1.0f;
                }
            }

            var oneHot = Tensor.FromArray(oneHotData, new TensorShape(numTokens, vocabSize), embeddingTable.Device);
            return oneHot.MatMul(embeddingTable);
        }

        public long ComputeTotalFlops(int batchSize, int seqLen, int loops)
        {
            if (batchSize <= 0) throw new ArgumentOutOfRangeException(nameof(batchSize));
            if (seqLen <= 0) throw new ArgumentOutOfRangeException(nameof(seqLen));
            if (loops < 1 || loops > _maxLoops) throw new ArgumentOutOfRangeException(nameof(loops));

            long tokens = (long)batchSize * seqLen;

            // Non-recurrent prelude & coda:
            long preludeFlops = 2L * tokens * _factorDim * _hiddenDim;
            long codaFlops = (2L * tokens * _hiddenDim * _factorDim) + (2L * tokens * _factorDim * _vocabSize);
            long nonRecurrentFlops = preludeFlops + codaFlops;

            // Per-loop transformer operations:
            long qkvFlops = 2L * tokens * _hiddenDim * (3L * _hiddenDim);
            long attnFlops = 4L * batchSize * seqLen * seqLen * _hiddenDim;
            long outProjFlops = 2L * tokens * _hiddenDim * _hiddenDim;
            long ffnFlops = 6L * tokens * _hiddenDim * _ffnDim;

            long flopsPerLoop = qkvFlops + attnFlops + outProjFlops + ffnFlops;

            return nonRecurrentFlops + ((long)loops * flopsPerLoop);
        }

        public override void To(Device targetDevice)
        {
            base.To(targetDevice);
            _core?.To(targetDevice);
            RebuildParameters();
        }

        public int ComputeTotalUniqueParameters()
        {
            int total = 0;
            var visited = new HashSet<ITensor>(ReferenceEqualityComparer.Instance);
            foreach (var param in Parameters())
            {
                if (param != null && visited.Add(param))
                {
                    total += param.Shape.TotalElements;
                }
            }
            return total;
        }

        public void ExportOzm(string filePath)
        {
            var manifest = new
            {
                Format = "OZM-1.0",
                Architecture = nameof(RecurrentDepthTransformer),
                HiddenDim = _hiddenDim,
                FfnDim = _ffnDim,
                NumHeads = _numHeads,
                Recurrence = _activeLoops,
                DefaultLoops = _defaultLoops,
                MaxLoops = _maxLoops,
                UniqueParameters = ComputeTotalUniqueParameters(),
                TimestampUtc = DateTime.UtcNow.ToString("o")
            };

            string json = JsonSerializer.Serialize(manifest, new JsonSerializerOptions { WriteIndented = true });
            File.WriteAllText(filePath, json);
        }
    }
}