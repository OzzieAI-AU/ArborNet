using System;

namespace ArborNet.Layers;

/// <summary>
/// Vertical slice: metric / distortion helpers for geometric embedding research.
/// Auto Research 20260919_022136_47a292 — pure C# (no ILayer) so sandbox can compile cleanly.
/// Expand after Integrate; do not claim LM perplexity validates this geometry.
/// </summary>
public static class GeometricEmbeddingSlice
{
    public static double DistortionRatio(double sourceDistance, double embeddingDistance)
    {
        if (sourceDistance <= 1e-12) return 0;
        return Math.Abs(embeddingDistance / sourceDistance - 1.0);
    }

    public static double LorentzInner(ReadOnlySpan<float> a, ReadOnlySpan<float> b)
    {
        if (a.Length == 0 || b.Length == 0) return 0;
        int n = Math.Min(a.Length, b.Length);
        double s = -((double)a[0] * b[0]);
        for (int i = 1; i < n; i++) s += (double)a[i] * b[i];
        return s;
    }

    public static double HyperbolicDistanceFromInner(double lorentzInner)
    {
        var v = Math.Max(1.0, -lorentzInner);
        return Math.Log(v + Math.Sqrt(v * v - 1.0));
    }

    public static float[] L2Normalize(ReadOnlySpan<float> x)
    {
        double s = 0;
        for (int i = 0; i < x.Length; i++) s += x[i] * (double)x[i];
        s = Math.Sqrt(Math.Max(s, 1e-12));
        var y = new float[x.Length];
        for (int i = 0; i < x.Length; i++) y[i] = (float)(x[i] / s);
        return y;
    }
}
