namespace ArborNet.Layers
{
    using System;
    using System.Collections.Generic;
    using ArborNet.Core.Interfaces;
    using ArborNet.Core.Layers;
    using ArborNet.Core.Tensors;
    using ArborNet.Layers.Normalization;

    /// <summary>
    /// Encapsulates a shared transformer layer core (Self-Attention + SwiGLU FFN) that is invoked recurrently.
    /// Parameters are registered exactly once, preventing multi-stepping or duplicated allocation in optimizers.
    /// </summary>
    public sealed class LoopedTransformerCore : BaseLayer
    {
        private readonly int _hiddenDim;
        private readonly int _ffnDim;
        private readonly int _numHeads;
        private readonly float _layerNormEps;

        private readonly RMSNorm _attnNorm;
        private readonly RMSNorm _ffnNorm;

        private readonly Linear _qkvProj;
        private readonly Linear _outProj;
        private readonly Linear _wGate;
        private readonly Linear _wUp;
        private readonly Linear _wDown;

        public int HiddenDim => _hiddenDim;
        public int FfnDim => _ffnDim;
        public int NumHeads => _numHeads;

        public LoopedTransformerCore(int hiddenDim, int ffnDim, int numHeads, float layerNormEps = 1e-5f)
        {
            if (hiddenDim <= 0 || ffnDim <= 0 || numHeads <= 0)
            {
                throw new ArgumentException("Hidden dimension, FFN dimension, and head count must be positive.");
            }
            if (hiddenDim % numHeads != 0)
            {
                throw new ArgumentException("Hidden dimension must be divisible by the number of heads.");
            }
            if (ffnDim % 2 != 0)
            {
                throw new ArgumentException($"FFN dimension must be even for SwiGLU decomposition, got {ffnDim}.");
            }

            _hiddenDim = hiddenDim;
            _ffnDim = ffnDim;
            _numHeads = numHeads;
            _layerNormEps = layerNormEps;

            _attnNorm = new RMSNorm(hiddenDim, layerNormEps);
            _ffnNorm = new RMSNorm(hiddenDim, layerNormEps);

            _qkvProj = new Linear(hiddenDim, 3 * hiddenDim);
            _outProj = new Linear(hiddenDim, hiddenDim);

            _wGate = new Linear(hiddenDim, ffnDim);
            _wUp = new Linear(hiddenDim, ffnDim);
            _wDown = new Linear(ffnDim, hiddenDim);
        }

        public override ITensor Forward(ITensor input)
        {
            ArgumentNullException.ThrowIfNull(input);

            // Sublayer 1: RMSNorm + Self-Attention with pre-norm residual
            ITensor normAttn = _attnNorm.Forward(input);
            ITensor attnOut = ForwardAttention(normAttn);
            ITensor residualAttn = input.Add(attnOut);

            // Sublayer 2: RMSNorm + SwiGLU FFN with pre-norm residual
            ITensor normFfn = _ffnNorm.Forward(residualAttn);
            ITensor ffnOut = ForwardSwiGLU(normFfn);
            ITensor output = residualAttn.Add(ffnOut);

            return output;
        }

        private ITensor ForwardAttention(ITensor x)
        {
            // [B, S, D] -> [B, S, 3 * D]
            ITensor qkv = _qkvProj.Forward(x);
            int batch = qkv.Shape[0];
            int seqLen = qkv.Shape[1];
            int headDim = _hiddenDim / _numHeads;
            float scale = 1.0f / MathF.Sqrt(headDim);

            // Split Q, K, V across the last dimension via Slice: [B, S, D] each
            ITensor qChunk = qkv.Slice((0, batch, 1), (0, seqLen, 1), (0, _hiddenDim, 1));
            ITensor kChunk = qkv.Slice((0, batch, 1), (0, seqLen, 1), (_hiddenDim, 2 * _hiddenDim, 1));
            ITensor vChunk = qkv.Slice((0, batch, 1), (0, seqLen, 1), (2 * _hiddenDim, 3 * _hiddenDim, 1));

            // Reshape and permute to [B, H, S, headDim]
            ITensor q = qChunk.Reshape(batch, seqLen, _numHeads, headDim).Transpose(new[] { 0, 2, 1, 3 });
            ITensor k = kChunk.Reshape(batch, seqLen, _numHeads, headDim).Transpose(new[] { 0, 2, 1, 3 });
            ITensor v = vChunk.Reshape(batch, seqLen, _numHeads, headDim).Transpose(new[] { 0, 2, 1, 3 });

            // Scaled dot product: [B, H, S, S]
            ITensor scores = q.MatMul(k.Transpose(new[] { 0, 1, 3, 2 })).Multiply(scale);
            ITensor weights = scores.Softmax(-1);
            ITensor context = weights.MatMul(v);

            // Reassemble heads back to [B, S, D]
            ITensor assembled = context.Transpose(new[] { 0, 2, 1, 3 }).Reshape(batch, seqLen, _hiddenDim);
            return _outProj.Forward(assembled);
        }

        private ITensor ForwardSwiGLU(ITensor x)
        {
            // SwiGLU: (Swish(x @ W_gate) * (x @ W_up)) @ W_down
            ITensor gate = _wGate.Forward(x);
            ITensor up = _wUp.Forward(x);

            ITensor swishGate = gate.Multiply(gate.Sigmoid());
            ITensor hidden = swishGate.Multiply(up);
            return _wDown.Forward(hidden);
        }

        public override IEnumerable<ITensor> Parameters()
        {
            var seen = new HashSet<ITensor>(ReferenceEqualityComparer.Instance);
            var sublayers = new BaseLayer[] { _attnNorm, _ffnNorm, _qkvProj, _outProj, _wGate, _wUp, _wDown };

            foreach (var layer in sublayers)
            {
                foreach (var param in layer.Parameters())
                {
                    if (seen.Add(param))
                    {
                        yield return param;
                    }
                }
            }
        }
    }
}